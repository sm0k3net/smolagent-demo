# ============================================
# Pentest.Systems Assistant - Environment Configuration
# ============================================
# Copy this file to .env and configure your values
# Required fields are marked with [REQUIRED]

# ============================================
# AI Model Configuration [REQUIRED]
# ============================================
# DeepSeek API key for the AI model
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Alternative: OpenAI compatible API
# OPENAI_API_KEY=your_openai_key
# OPENAI_API_BASE=https://api.openai.com/v1

# ============================================
# Search Engine Configuration
# ============================================
# SearXNG instance URL for web searches
SEARXNG_BASE_URL=https://searxng.example.org

# ============================================
# OSINT API Keys (Optional but Recommended)
# ============================================
# VirusTotal - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Shodan - https://account.shodan.io/
SHODAN_API_KEY=

# Hunter.io - https://hunter.io/api-keys
HUNTER_API_KEY=

# SecurityTrails - https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=

# Have I Been Pwned - https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ============================================
# Telegram Bot Integration (Optional)
# ============================================
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=
# Default chat ID for notifications
TELEGRAM_CHAT_ID=

# ============================================
# DefectDojo Integration (Optional)
# ============================================
# Base URL of your DefectDojo instance (no trailing slash)
DEFECTDOJO_BASE_URL=https://dojo.example.com
# API key from DefectDojo (/api/key-v2)
DEFECTDOJO_API_KEY=
# Whether to verify TLS certificates
DEFECTDOJO_VERIFY_SSL=true
# Default Product Type ID for new products
DEFECTDOJO_DEFAULT_PRODUCT_TYPE_ID=1

# ============================================
# Application Settings
# ============================================
# Environment: dev, staging, production
ENV=dev

# Custom prompt file path
PROMPT_PATH=app/prompts/owasp_pen_tester.md

# Server configuration
HOST=0.0.0.0
PORT=8000

# ============================================
# Docker Configuration
# ============================================
# Container resource limits (used by docker-compose)
# CONTAINER_CPU_LIMIT=2
# CONTAINER_MEMORY_LIMIT=4G


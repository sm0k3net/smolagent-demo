# Copy to .env and adjust values
DEEPSEEK_API_KEY=replace_with_key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
SEARXNG_BASE_URL=https://searxng.example.org
ENV=dev
PROMPT_PATH=app/prompts/owasp_pen_tester.md

# DefectDojo configuration
# Base URL of your DefectDojo instance (no trailing slash), e.g. https://dojo.example.com
DEFECTDOJO_BASE_URL=https://dojo.example.com
# API key from DefectDojo (/api/key-v2) used as Authorization: Token <key>
DEFECTDOJO_API_KEY=replace_with_defectdojo_token
# Whether to verify TLS certificates when calling DefectDojo (true/false)
DEFECTDOJO_VERIFY_SSL=true
# Default Product Type ID used when creating products (check /api/v2/product_types/ on your Dojo)
DEFECTDOJO_DEFAULT_PRODUCT_TYPE_ID=1
